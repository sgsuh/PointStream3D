{
  "name": "pointstream3d",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Stream and render COPC point clouds directly in CesiumJS — no pre-tiling.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "smoke": "node scripts/smoke.mjs",
    "build:sw": "node scripts/build-sw.mjs"
  },
  "dependencies": {
    "cesium": "^1.123.0",
    "copc": "0.0.8",
    "laz-perf": "0.0.7",
    "proj4": "^2.15.0"
  },
  "devDependencies": {
    "@types/proj4": "^2.5.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-cesium": "^1.2.23"
  }
}
